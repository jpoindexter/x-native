{
  "name": "x-native",
  "version": "0.1.0",
  "description": "Native TypeScript client for X/Twitter's GraphQL — search, bookmarks, read tweets. Keyless cookie auth, zero dependencies, no Python, self-healing query IDs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "x-native": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "x": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "twitter",
    "x",
    "graphql",
    "bookmarks",
    "scraper",
    "native",
    "no-api-key",
    "cookie-auth",
    "typescript",
    "zero-dependency"
  ],
  "author": "Jason Poindexter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
